{
  "name": "openrouter-image-mcp",
  "version": "1.0.0",
  "description": "Minimal Streamable HTTP MCP server exposing only OpenRouter image generation (generate_image) to LibreChat. Per-request OpenRouter API keys via the Authorization header. No OAuth, no Fireworks.",
  "type": "module",
  "main": "server.js",
  "exports": "./server.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mock:openrouter": "node scripts/mock-openrouter.js",
    "smoke": "node scripts/smoke.js"
  },
  "keywords": [
    "mcp",
    "openrouter",
    "image-generation",
    "librechat",
    "streamable-http"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
}
