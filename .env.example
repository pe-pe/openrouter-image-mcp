# HTTP server
HOST=0.0.0.0
PORT=3333

# OpenRouter API
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
# Optional admin fallback. Per-user keys are sent by LibreChat in the
# Authorization header and always take precedence over this value.
OPENROUTER_API_KEY=

# Model controls. Any OpenRouter image model slug is accepted.
DEFAULT_IMAGE_MODEL=recraft/recraft-v4.1-flash-v2:free

# Limits
OPENROUTER_TIMEOUT_MS=120000
MAX_BODY_BYTES=1000000

# Optional CORS. Comma-separated origins or * for any origin. Leave empty to
# omit CORS headers entirely. LibreChat server-to-server calls do not need CORS.
CORS_ORIGIN=

# Request logging (on by default). Set to false to disable. Prompts, API keys,
# and response bodies are never logged.
LOG_REQUESTS=true

# Optional OpenRouter attribution headers
OPENROUTER_APP_TITLE=openrouter-image-mcp
OPENROUTER_APP_REFERER=
